static void Main()
{
int x=int.Parse(Console.ReadLine());
int y=int.Parse(Console.ReadLine());
Console.WriteLine(Pow(x,y));
}
static int Pow(int x,int y)
{
int r=1;
for (int i=0; i<y; i++)
{
    r*=x;
}
return r;
}

