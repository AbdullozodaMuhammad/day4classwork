// 3 zadanie

static void Main()
{
int n=int.Parse(Console.ReadLine());

int min=MinDigit(n);
int max=MaxDigit(n);

Console.WriteLine(min+" + "+max+" = "+(min+max));
}
static int MinDigit(int n)
{
int min=9;

while (n>0)
{
    int d=n%10;
    if (d<min)
        min=d;
    n/=10;
}
return min;
}
static int MaxDigit(int n)
{
int max=0;

while (n>0)
{
    int d=n%10;

    if (d>max)
        max=d;
    n/=10;
}
return max;
}

